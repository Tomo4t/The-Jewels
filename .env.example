# ---------------------------------------------------------------------------
# The Jewels — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# Public origin of the site. Used for Open Graph URLs and cookie settings.
# On Railway or Render this is detected automatically from the platform's
# domain, so you can leave it unset there.
PUBLIC_ORIGIN=http://localhost:3000

# REQUIRED IN PRODUCTION.
# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database lives.
# In Docker and on Railway this defaults to /data/jewels.db (the volume).
DATABASE_PATH=./data/jewels.db

# Where chapter images and update files are read from and written to.
# In Docker and on Railway this defaults to /data/content (the volume).
CONTENT_DIR=./content

# Read-only copy of the chapters committed to the repo. If CONTENT_DIR is empty
# on boot (a freshly mounted volume), these are copied in once so the site does
# not come up with an empty shelf. Ignored once real content exists.
CONTENT_BASELINE_DIR=./content-baseline

# Set to "false" to close public sign-ups (existing accounts still work).
ALLOW_REGISTRATION=true

# Set to "false" to publish comments immediately instead of holding them
# for moderator approval. Auto-flagged comments are always held.
MODERATION_QUEUE=true

# ---------------------------------------------------------------------------
# Optional: AI-assisted comment moderation.
# Without a key, only the built-in rule-based filter runs — which is always on.
# With a key, each comment additionally gets a Claude moderation pass.
# Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-haiku-4-5
